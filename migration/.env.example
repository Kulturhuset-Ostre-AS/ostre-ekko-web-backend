# Copy to migration/.env and adjust.
# Craft 3 GraphQL endpoint exposed by migration/docker/00-craft3-up.sh
CRAFT_GRAPHQL_URL=http://localhost:8390/api
# Public schema is widened on bring-up, so a token is usually NOT needed.
CRAFT_GRAPHQL_TOKEN=

# Locales (Craft sites) to export.
LOCALES=en,nb

# Payload app location (created during scaffold phase).
PAYLOAD_APP_DIR=./payload-app

# Asset source (used by 04-transfer-assets.mjs). Leave blank to skip.
GCS_BUCKET=
