# Copy to .env (compose reads it). Defaults work with docker-compose.payload.yml.
DATABASE_URI=postgres://payload:payload@postgres:5432/payload
PAYLOAD_SECRET=dev-secret-change-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated origins allowed to call the API (the local frontend).
PAYLOAD_CORS=http://localhost:5173,http://localhost:8788,http://localhost:3001
