# =============================================================================
# Production image for the Payload 3 (Next 16) CMS on Google Cloud Run.
#
# This is a NEW prod artifact and is intentionally separate from ./Dockerfile,
# which is the dev image (`payload dev` + hot reload). Do not merge the two.
#
# Multi-stage:
#   deps    - install node_modules (with build toolchain available)
#   build   - `next build` (Payload compiles its config at build time)
#   runner  - slim runtime that serves `next start` on Cloud Run's $PORT
#
# NOTE on next.config.mjs: it does NOT set `output: "standalone"`, so we cannot
# ship a trimmed standalone bundle. The runner therefore copies the full
# node_modules, .next, package.json, next.config.mjs and src (Payload reads
# src/payload.config.ts at RUNTIME, not just at build). If standalone output is
# added later, this stage can be slimmed considerably.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: deps - install all dependencies (incl. @payloadcms/storage-gcs, sharp)
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS deps
WORKDIR /app

# ca-certificates + openssl: TLS to Postgres/GCS and bits sharp/node-gyp expect.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

# Copy manifests first for layer caching. package-lock.json is committed, so use
# `npm ci` for deterministic, reproducible installs (fails if lock is out of sync
# with package.json — which is exactly the guarantee we want for prod images).
COPY package.json package-lock.json ./
RUN npm ci

# -----------------------------------------------------------------------------
# Stage 2: build - compile the Next/Payload app
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app

# Build as production so Next optimizes output.
ENV NODE_ENV=production
# Silence Next telemetry in CI/build.
ENV NEXT_TELEMETRY_DISABLED=1

# Reuse installed deps, then bring in the full source (payload.config + collections).
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# `next build` also runs Payload's build hooks (importmap, types) via withPayload.
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: runner - minimal runtime that Cloud Run starts
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Runtime libs: openssl for TLS to Cloud SQL Postgres and GCS.
#
# NOTE on sharp: sharp ^0.34 ships prebuilt libvips binaries for linux-x64/arm64,
# and node:22-bookworm-slim satisfies their glibc/libstdc++ requirements out of
# the box, so no extra apt packages are needed here. If you ever pin an older
# sharp or build on musl (Alpine), you'd need to add libvips/build deps.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

# Run as the unprivileged `node` user that the base image already provides.
# .next must be writable at runtime (Next caches there), so chown what we copy.

# Built app + everything the runtime needs. next.config.mjs uses withPayload and
# src holds payload.config.ts which Payload loads at RUNTIME, so both must ship.
COPY --from=build --chown=node:node /app/.next             ./.next
COPY --from=build --chown=node:node /app/node_modules      ./node_modules
COPY --from=build --chown=node:node /app/package.json      ./package.json
COPY --from=build --chown=node:node /app/next.config.mjs   ./next.config.mjs
COPY --from=build --chown=node:node /app/src               ./src

# There is no ./public dir in this app today. If one is added, also copy it:
#   COPY --from=build --chown=node:node /app/public ./public

USER node

# -----------------------------------------------------------------------------
# Cloud Run contract: the platform injects PORT (default 8080) and the container
# MUST listen on it. `next start -p <port>` honours the flag. We default to 3000
# for plain `docker run` locally, but on Cloud Run $PORT (8080) always wins.
# -----------------------------------------------------------------------------
ENV PORT=8080
EXPOSE 8080

# sh -c so ${PORT} is expanded at runtime from Cloud Run's injected env var.
CMD ["sh", "-c", "npx next start -p ${PORT:-3000}"]
